from collections.abc import Iterator

type Scalar = float | int | bool
type Operand = tensor | Scalar
type Index = int | slice | None

class dtype: ...

float32: dtype
int32: dtype
int64: dtype
bfloat16: dtype

class constexpr:
    def __init__(self, value: int | str) -> None: ...

class tensor:
    def __add__(self, other: Operand) -> tensor: ...
    def __radd__(self, other: Operand) -> tensor: ...
    def __sub__(self, other: Operand) -> tensor: ...
    def __rsub__(self, other: Operand) -> tensor: ...
    def __mul__(self, other: Operand) -> tensor: ...
    def __rmul__(self, other: Operand) -> tensor: ...
    def __truediv__(self, other: Operand) -> tensor: ...
    def __floordiv__(self, other: Operand) -> tensor: ...
    def __lt__(self, other: Operand) -> tensor: ...
    def __le__(self, other: Operand) -> tensor: ...
    def __gt__(self, other: Operand) -> tensor: ...
    def __ge__(self, other: Operand) -> tensor: ...
    def __and__(self, other: Operand) -> tensor: ...
    def __or__(self, other: Operand) -> tensor: ...
    def __invert__(self) -> tensor: ...
    def __bool__(self) -> bool: ...
    def __getitem__(self, index: Index | tuple[Index, ...]) -> tensor: ...
    def to(self, dtype: dtype) -> tensor: ...

def program_id(axis: int) -> tensor: ...
def arange(start: int, end: int) -> tensor: ...
def zeros(shape: tuple[int, ...], dtype: dtype) -> tensor: ...
def full(shape: tuple[int, ...], value: Scalar, dtype: dtype) -> tensor: ...
def load(pointer: tensor, mask: tensor | None = None, other: Scalar | constexpr | None = None) -> tensor: ...
def store(pointer: tensor, value: Operand, mask: tensor | None = None) -> None: ...
def atomic_add(pointer: tensor, value: Operand, mask: tensor | None = None, sem: constexpr | None = None) -> tensor: ...
def dot(a: tensor, b: tensor) -> tensor: ...
def sum(x: tensor, axis: int) -> tensor: ...
def min(x: tensor, axis: int) -> tensor: ...
def argmin(x: tensor, axis: int) -> tensor: ...
def cumsum(x: tensor, axis: int) -> tensor: ...
def maximum(x: tensor, y: Operand) -> tensor: ...
def where(condition: tensor, x: Operand, y: Operand) -> tensor: ...
def static_range(start: int, end: int | None = None, step: int | None = None) -> Iterator[int]: ...
def range(start: tensor, end: tensor, step: int) -> Iterator[tensor]: ...
